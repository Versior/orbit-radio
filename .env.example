# 复制为 .env 后填写。任何 OpenAI 兼容的 Chat Completions 接口都可以。
# 不填时 AI 找台自动退回本地关键词理解。

# 接口地址（不含 /chat/completions），例如 https://api.deepseek.com 或 https://api.openai.com/v1
AI_BASE_URL=
# 模型名，例如 deepseek-chat、gpt-4o-mini、qwen-plus
AI_MODEL=
# 密钥只放在这里或系统环境变量中，不要提交到仓库
AI_API_KEY=

# 可选
# PORT=8765
# HOST=127.0.0.1
